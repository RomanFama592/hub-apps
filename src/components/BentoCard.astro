---
import { Image } from "astro:assets";
import type { Service } from "../types/hub";
import type { BentoLeaf } from "../types/hub";

interface Props {
  service: Service;
  desktop: BentoLeaf;
  mobile: BentoLeaf;
}

const { service, desktop, mobile } = Astro.props;

// Normalizar la ruta de la imagen
const imageSrc = service.image
  ? (service.image.startsWith("/") || service.image.startsWith("http")
      ? service.image
      : `/assets/${service.image}`)
  : null;

// Coordenadas de grid (1-index, CSS Grid usa líneas no celdas) para
// ambos breakpoints. Se exponen como custom properties y el CSS
// decide cuál set usar según el media query — así el cambio de
// tamaño de pantalla es instantáneo, sin JS ni recálculo en cliente.
const gridVars = [
  `--dcs:${desktop.x + 1}`,
  `--dce:${desktop.x + 1 + desktop.w}`,
  `--drs:${desktop.y + 1}`,
  `--dre:${desktop.y + 1 + desktop.h}`,
  `--mcs:${mobile.x + 1}`,
  `--mce:${mobile.x + 1 + mobile.w}`,
  `--mrs:${mobile.y + 1}`,
  `--mre:${mobile.y + 1 + mobile.h}`
].join(";");

// Tamaño relativo del bloque (1 a 4 celdas) — se usa como pista extra
// para pequeños ajustes discretos que un container query no cubre
// (p. ej. mostrar/ocultar la descripción).
const desktopArea = desktop.w * desktop.h;
---

<a
  href={service.url}
  target="_blank"
  rel="noopener noreferrer"
  class="bento-block"
  data-url={service.url}
  data-area={desktopArea}
  style={gridVars}
>
  {
    imageSrc && (
      <Image
        src={imageSrc}
        alt={service.name}
        width={400}
        height={300}
        loading="lazy"
        decoding="async"
        class="bento-bg-img"
      />
    )
  }

  <div class="card-top">
    <div class="status-dot" title="Comprobando estado..."></div>

    <!-- Menú de 3 puntos verticales -->
    <div class="options-wrapper">
      <button class="options-btn" aria-label="Opciones del servicio" type="button">
        &#8942;
      </button>
      <div class="options-menu">
        <button
          type="button"
          class="menu-item edit-btn"
          data-id={service.id}
          data-name={service.name}
          data-desc={service.description || ""}
          data-url={service.url}
          data-image={service.image || ""}
        >
          ✏️ Editar
        </button>
        <button
          type="button"
          class="menu-item delete-btn"
          data-id={service.id}
          data-name={service.name}
        >
          🗑️ Eliminar
        </button>
      </div>
    </div>
  </div>

  <div class="info-card">
    <h3 class="service-title">{service.name}</h3>
    {service.description && <p class="service-desc">{service.description}</p>}
  </div>
</a>

<style>
  .bento-block {
    /* Posición en el grid: desktop por defecto, móvil vía media query
       (ver más abajo). Los valores concretos llegan como custom
       properties inline desde el frontmatro de Astro. */
    grid-column: var(--dcs) / var(--dce);
    grid-row: var(--drs) / var(--dre);

    /* Container query: el tamaño real que el grid le asigna a esta
       tarjeta (que varía según el bloque procedural: 1x1, 2x1, 1x2,
       2x2) pasa a ser la unidad de referencia para escalar tipografía,
       paddings e iconos internos SIN romper el layout ni recurrir a
       JS de resize. */
    container-type: size;
    container-name: bento-card;

    background: var(--surface);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: clamp(12px, 3cqw, 20px);
    padding: clamp(0.65rem, 5cqw, 1.25rem);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                background-color 0.25s ease;
    box-shadow: var(--card-shadow);
  }

  /* En móvil el bloque usa las coordenadas procedurales calculadas
     para 3 columnas, no las de escritorio. */
  @media (max-width: 768px) {
    .bento-block {
      grid-column: var(--mcs) / var(--mce);
      grid-row: var(--mrs) / var(--mre);
    }
  }

  .bento-block:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: var(--card-shadow-hover);
    background: var(--surface-hover);
  }

  .bento-bg-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.45;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .bento-block:hover .bento-bg-img {
    opacity: 0.65;
    transform: scale(1.05);
  }

  .card-top {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status-dot {
    width: clamp(7px, 3.5cqw, 12px);
    height: clamp(7px, 3.5cqw, 12px);
    flex-shrink: 0;
    border-radius: 50%;
    background-color: #9ca3af;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.2);
  }

  :global(.status-dot.active) {
    background-color: #22c55e;
    box-shadow: 0 0 10px #22c55e;
  }

  :global(.status-dot.inactive) {
    background-color: #ef4444;
    box-shadow: 0 0 10px #ef4444;
  }

  /* Estilos Menú de Opciones */
  .options-wrapper {
    position: relative;
  }

  .options-btn {
    background: var(--surface);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 50%;
    width: clamp(20px, 11cqw, 32px);
    height: clamp(20px, 11cqw, 32px);
    font-size: clamp(0.7rem, 6cqw, 1.2rem);
    flex-shrink: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .options-btn:hover {
    background: var(--surface-hover);
    transform: scale(1.1);
  }

  .options-menu {
    display: none;
    position: fixed;
    top: 38px;
    right: 0;
    background: var(--modal-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.4rem;
    box-shadow: var(--card-shadow-hover);
    z-index: 9999;
    min-width: 120px;
    flex-direction: column;
    gap: 0.2rem;
  }

  .options-menu.show {
    display: flex;
  }

  .menu-item {
    background: transparent;
    border: none;
    color: var(--text);
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-size: 0.85rem;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: background-color 0.2s ease;
  }

  .menu-item:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .delete-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .info-card {
    position: relative;
    z-index: 1;
    background: var(--surface);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: clamp(0.4rem, 3.5cqw, 0.75rem) clamp(0.5rem, 4.5cqw, 1rem);
    border-radius: clamp(8px, 2.5cqw, 12px);
    border: 1px solid var(--border);
    margin-top: clamp(0.5rem, 8cqb, 2rem);
    min-width: 0;
  }

  .service-title {
    margin: 0;
    font-size: clamp(0.7rem, 6.5cqw, 1.1rem);
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .service-desc {
    margin: 0.2rem 0 0 0;
    font-size: clamp(0.6rem, 4cqw, 0.85rem);
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Bloques muy pequeños (1x1) o muy bajos (2x1): la descripción sobra
     y solo generaría ruido o desbordamiento; el container query mide
     el tamaño REAL renderizado de cada tarjeta, así que esto reacciona
     igual de bien a cualquier combinación de columnas/filas. */
  @container bento-card (max-width: 150px) {
    .service-desc {
      display: none;
    }
  }

  @container bento-card (max-height: 110px) {
    .service-desc {
      display: none;
    }
    .info-card {
      margin-top: clamp(0.35rem, 6cqb, 1rem);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Manejo del menú de 3 puntos en cada tarjeta
    document.querySelectorAll(".bento-block").forEach((card) => {
      const optionsBtn = card.querySelector(".options-btn");
      const optionsMenu = card.querySelector(".options-menu");
      const editBtn = card.querySelector(".edit-btn");
      const deleteBtn = card.querySelector(".delete-btn");

      // Abrir/Cerrar menú sin activar el enlace de la tarjeta
      optionsBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        // Cerrar otros menús abiertos
        document.querySelectorAll(".options-menu.show").forEach((m) => {
          if (m !== optionsMenu) m.classList.remove("show");
        });

        optionsMenu?.classList.toggle("show");
      });

      // Acción de Editar: Notifica mediante un evento global al modal
      editBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        optionsMenu?.classList.remove("show");

        const target = e.currentTarget as HTMLElement;
        const serviceData = {
          id: target.dataset.id,
          name: target.dataset.name,
          description: target.dataset.desc,
          url: target.dataset.url,
          image: target.dataset.image
        };

        window.dispatchEvent(
          new CustomEvent("open-edit-modal", { detail: serviceData })
        );
      });

      // Acción de Eliminar
      deleteBtn?.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        optionsMenu?.classList.remove("show");

        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const name = target.dataset.name;

        if (confirm(`¿Estás seguro de que deseas eliminar "${name}"?`)) {
          try {
            const res = await fetch("/api/services", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id })
            });

            if (res.ok) {
              window.location.reload();
            }
          } catch (err) {
            console.error("Error al eliminar el servicio:", err);
          }
        }
      });
    });

    // Cerrar menús al hacer clic fuera
    document.addEventListener("click", () => {
      document.querySelectorAll(".options-menu.show").forEach((m) => {
        m.classList.remove("show");
      });
    });
  });
</script>