---
---
<button id="openModalBtn" class="add-btn" aria-label="Añadir Servicio">+</button>
<button id="regenBtn" class="regen-btn" aria-label="Regenerar avatares generados" title="Regenerar avatares generados">
  ↻
</button>

<dialog id="addModal">
  <div class="modal-header">
    <h2 id="modalTitle">Añadir Servicio</h2>
    <button type="button" id="closeModalCross" class="close-cross">&times;</button>
  </div>

  <form id="addForm">
    <!-- Campo oculto para el ID si se edita -->
    <input type="hidden" id="sId" />

    <div class="field">
      <label for="sName">Nombre</label>
      <input type="text" id="sName" placeholder="Ej. Pi-hole" required autocomplete="off" />
    </div>

    <div class="field">
      <label for="sDesc">Descripción (Opcional)</label>
      <input type="text" id="sDesc" placeholder="Ej. Bloqueador de publicidad" autocomplete="off" />
    </div>

    <div class="field">
      <label for="sUrl">URL del Servicio</label>
      <input type="url" id="sUrl" placeholder="http://192.168.1.10:80" required autocomplete="off" />
    </div>

    <div class="field">
      <div class="search-label-row">
        <label>Imagen del Servicio</label>
        <button type="button" id="btnSearchImg" class="btn-secondary">Buscar Imágenes</button>
      </div>
      <div class="image-options" id="imgContainer"></div>
      <input type="text" id="sImageCustom" placeholder="O pega un enlace de imagen directamente" autocomplete="off" />
    </div>

    <div class="modal-actions">
      <button type="button" id="cancelModalBtn" class="btn-cancel">Cancelar</button>
      <button type="submit" id="submitModalBtn" class="btn-primary">Guardar Servicio</button>
    </div>
  </form>
</dialog>

<style>
  .add-btn {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 50%;
    width: 56px;
    height: 56px;
    font-size: 28px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease;
    z-index: 100;
  }

  .add-btn:hover {
    transform: scale(1.1);
    background: var(--accent-hover);
  }

  /* Botón secundario para regenerar la base de avatares de iniciales
     en public/assets. Se ubica junto al botón "+" pero con estilo
     glass/secundario para no competir visualmente con la acción
     principal. */
  .regen-btn {
    position: fixed;
    bottom: 2rem;
    right: 5.5rem;
    background: var(--surface);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 56px;
    height: 56px;
    font-size: 24px;
    cursor: pointer;
    box-shadow: var(--card-shadow);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease;
    z-index: 100;
  }

  .regen-btn:hover {
    transform: scale(1.1) rotate(45deg);
    background: var(--surface-hover);
  }

  .regen-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .regen-btn.spinning {
    animation: regen-spin 0.9s linear infinite;
  }

  @keyframes regen-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  dialog {
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.5rem;
    width: 420px;
    max-width: 90vw;
    background: var(--modal-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: var(--text);
    box-shadow: var(--card-shadow-hover);
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .close-cross {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .field {
    margin-bottom: 1rem;
  }

  .field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
    color: var(--text-muted);
  }

  .search-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--input-bg);
    color: var(--text);
    outline: none;
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
  }

  input:focus {
    border-color: var(--accent);
  }

  .image-options {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    cursor: pointer;
    font-weight: 600;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn-cancel {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
    border: none;
    padding: 0.55rem 1.25rem;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }
</style>

<script>
  import type { SearchImageResponse } from "../types/hub";

  document.addEventListener("DOMContentLoaded", () => {
    const dialog = document.getElementById("addModal") as HTMLDialogElement | null;
    const openBtn = document.getElementById("openModalBtn");
    const cancelBtn = document.getElementById("cancelModalBtn");
    const closeCross = document.getElementById("closeModalCross");
    const addForm = document.getElementById("addForm") as HTMLFormElement | null;
    const modalTitle = document.getElementById("modalTitle");
    const submitBtn = document.getElementById("submitModalBtn");

    const sIdInput = document.getElementById("sId") as HTMLInputElement | null;
    const sNameInput = document.getElementById("sName") as HTMLInputElement | null;
    const sDescInput = document.getElementById("sDesc") as HTMLInputElement | null;
    const sUrlInput = document.getElementById("sUrl") as HTMLInputElement | null;
    const sImageCustomInput = document.getElementById("sImageCustom") as HTMLInputElement | null;
    const btnSearchImg = document.getElementById("btnSearchImg") as HTMLButtonElement | null;
    const imgContainer = document.getElementById("imgContainer");

    let selectedImage = "";

    const resetModal = () => {
      addForm?.reset();
      if (sIdInput) sIdInput.value = "";
      if (modalTitle) modalTitle.textContent = "Añadir Servicio";
      if (submitBtn) submitBtn.textContent = "Guardar Servicio";
      if (imgContainer) imgContainer.innerHTML = "";
      selectedImage = "";
    };

    openBtn?.addEventListener("click", () => {
      resetModal();
      dialog?.showModal();
    });

    cancelBtn?.addEventListener("click", () => dialog?.close());
    closeCross?.addEventListener("click", () => dialog?.close());

    // Regenerar la base de avatares de iniciales (public/assets)
    const regenBtn = document.getElementById("regenBtn") as HTMLButtonElement | null;
    regenBtn?.addEventListener("click", async () => {
      if (regenBtn.disabled) return;

      const confirmed = confirm(
        "Esto va a regenerar TODOS los avatares generados automáticamente (los que no son una imagen propia). ¿Continuar?"
      );
      if (!confirmed) return;

      regenBtn.disabled = true;
      regenBtn.classList.add("spinning");

      try {
        const res = await fetch("/api/regenerate-images", { method: "POST" });
        const data = await res.json();

        if (res.ok) {
          window.location.reload();
        } else {
          alert(`No se pudo regenerar: ${data.error || "error desconocido"}`);
          regenBtn.disabled = false;
          regenBtn.classList.remove("spinning");
        }
      } catch (err) {
        console.error("Error regenerando avatares:", err);
        alert("Error de red al regenerar los avatares.");
        regenBtn.disabled = false;
        regenBtn.classList.remove("spinning");
      }
    });

    // Escuchar evento de edición disparado por BentoCard
    window.addEventListener("open-edit-modal", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      resetModal();

      if (sIdInput) sIdInput.value = detail.id || "";
      if (sNameInput) sNameInput.value = detail.name || "";
      if (sDescInput) sDescInput.value = detail.description || "";
      if (sUrlInput) sUrlInput.value = detail.url || "";
      if (sImageCustomInput) sImageCustomInput.value = detail.image || "";

      if (modalTitle) modalTitle.textContent = "Editar Servicio";
      if (submitBtn) submitBtn.textContent = "Actualizar Cambios";

      dialog?.showModal();
    });

    btnSearchImg?.addEventListener("click", async () => {
      const query = sNameInput?.value.trim();
      if (!query) return alert("Escribe un nombre de servicio primero.");

      try {
        const res = await fetch("/api/search", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query })
        });

        const data: SearchImageResponse = await res.json();
        if (!imgContainer) return;

        imgContainer.innerHTML = "";
        selectedImage = "";

        data.images.forEach((imgUrl) => {
          const imgEl = document.createElement("img");
          imgEl.src = imgUrl;

          // Estilos explícitos inline para evitar bloqueos CSS
          Object.assign(imgEl.style, {
            width: "90px",
            height: "90px",
            objectFit: "cover",
            borderRadius: "10px",
            cursor: "pointer",
            border: "2px solid transparent",
            flexShrink: "0"
          });

          imgEl.onclick = () => {
            imgContainer.querySelectorAll("img").forEach((img) => {
              (img as HTMLElement).style.borderColor = "transparent";
            });
            imgEl.style.borderColor = "var(--accent)";
            selectedImage = imgUrl;
          };

          imgContainer.appendChild(imgEl);
        });
      } catch (err) {
        console.error("Error buscando imágenes:", err);
      }
    });

    // Envío del Formulario (Creación POST / Edición PUT)
    addForm?.addEventListener("submit", async (e: SubmitEvent) => {
      e.preventDefault();

      const id = sIdInput?.value;
      const finalImage = sImageCustomInput?.value.trim() || selectedImage;

      const payload = {
        id,
        name: sNameInput?.value.trim() ?? "",
        description: sDescInput?.value.trim() ?? "",
        url: sUrlInput?.value.trim() ?? "",
        imageUrl: finalImage
      };

      const method = id ? "PUT" : "POST";

      const res = await fetch("/api/services", {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        window.location.reload();
      }
    });
  });
</script>