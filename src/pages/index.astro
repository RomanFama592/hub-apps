---
import fs from "fs/promises";
import path from "path";
import Layout from "../layouts/Layout.astro";
import BentoGrid from "../components/BentoGrid.astro";
import AddServiceModal from "../components/AddServiceModal.astro";
import type { Config, Service } from "../types/hub";

// Carga de configuración JSON
const configPath = path.join(process.cwd(), "data/config.json");
let config: Config = { maxPerPage: 10, services: [] };

try {
  const content = await fs.readFile(configPath, "utf-8");
  config = JSON.parse(content);
} catch (e) {
  console.log("Configuración inicial no encontrada. Usando estado por defecto.");
}

// Función tipada para paginado: cuando hay más servicios que
// maxPerPage, se reparten en "páginas" navegables horizontalmente
// (cada una sigue siendo un bento grid completo, sin scroll vertical).
const chunkArray = <T,>(arr: T[], size: number): T[][] =>
  Array.from({ length: Math.ceil(arr.length / size) }, (_, i) =>
    arr.slice(i * size, i * size + size)
  );

const pages: Service[][] = chunkArray(config.services, config.maxPerPage);
---

<Layout title="Local Hub - Bento Dashboard">
  <main class="slider">
    {
      pages.length === 0 ? (
        <div class="empty-state">
          <h2>No tienes servicios agregados</h2>
          <p>Haz clic en el botón '+' para agregar el primero.</p>
        </div>
      ) : null
    }

    {
      pages.map((page, pageIndex) => (
        <section class="page" data-page-index={pageIndex}>
          <BentoGrid services={page} />
        </section>
      ))
    }
  </main>

  <AddServiceModal />
</Layout>

<style>
  /* Contenedor raíz: viewport lock estricto. dvh resuelve el clásico
     problema de 100vh en móvil (barras de navegador que aparecen o
     desaparecen); vh queda como fallback para navegadores sin soporte
     de unidades dinámicas. overflow:hidden en TODOS los niveles
     (slider + page) es lo que garantiza cero scroll vertical bajo
     cualquier circunstancia, incluso si algún contenido inesperado
     fuese más alto de lo previsto. */
  .slider {
    display: flex;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    box-sizing: border-box;
  }

  .slider::-webkit-scrollbar {
    display: none;
  }

  /* Cada página ocupa el 100% del viewport y aloja un BentoGrid
     completo. El padding vive aquí para que BentoGrid pueda asumir
     "ocupo el 100% de mi contenedor" sin preocuparse de márgenes. */
  .page {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    scroll-snap-align: start;
    padding: clamp(0.75rem, 2.5vw, 2rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  .empty-state {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--text-muted);
  }
</style>

<script>
  import type { PingResponse } from "../types/hub";

  document.addEventListener("DOMContentLoaded", () => {
    // El tamaño/posición de cada tarjeta ya llega calculado desde el
    // servidor (ver BentoGrid.astro + src/lib/bentoLayout.ts) como
    // custom properties CSS, así que aquí solo queda comprobar el
    // estado (ping) de cada servicio — cero recálculo de layout en
    // cliente, cero parpadeos, cero desajuste entre SSR y DOM.
    const blocks = document.querySelectorAll<HTMLElement>(".bento-block");

    blocks.forEach(async (block) => {
      const url = block.getAttribute("data-url");
      const dot = block.querySelector<HTMLElement>(".status-dot");
      if (!url || !dot) return;

      try {
        const res = await fetch("/api/ping", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url })
        });
        const data: PingResponse = await res.json();
        dot.classList.add(data.active ? "active" : "inactive");
      } catch (e) {
        dot.classList.add("inactive");
      }
    });
  });
</script>
