---
import fs from "fs/promises";
import Layout from "../layouts/Layout.astro";
import BentoGrid from "../components/BentoGrid.astro";
import AddServiceModal from "../components/AddServiceModal.astro";
import type { Config, Service } from "../types/hub";
import { CONFIG_PATH } from "../lib/contants";

// Carga de configuración JSON
let config: Config = { maxPerPage: 10, services: [] };

try {
  const content = await fs.readFile(CONFIG_PATH, "utf-8");
  config = JSON.parse(content);
} catch (e) {
  console.log("Error al leer la configuración:", e);
  console.log("Configuración inicial no encontrada. Usando estado por defecto.");
}

// Función tipada para paginado: cuando hay más servicios que
// maxPerPage, se reparten en "páginas" navegables horizontalmente
// (cada una sigue siendo un bento grid completo, sin scroll vertical).
const chunkArray = <T,>(arr: T[], size: number): T[][] =>
  Array.from({ length: Math.ceil(arr.length / size) }, (_, i) =>
    arr.slice(i * size, i * size + size)
  );

const pages: Service[][] = chunkArray(config.services, config.maxPerPage);
---

<Layout title="Local Hub - Bento Dashboard">
  <!-- Botón discreto para limpiar cookies -->
  <button 
    id="clear-cookies-btn" 
    class="secret-reset-btn" 
    title="Limpiar cookies y restablecer layout"
    aria-label="Limpiar cookies"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 6h18"></path>
      <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
      <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
    </svg>
  </button>

  <main class="slider">
    {
      pages.length === 0 ? (
        <div class="empty-state">
          <h2>No tienes servicios agregados</h2>
          <p>Haz clic en el botón '+' para agregar el primero.</p>
        </div>
      ) : null
    }

    {
      pages.map((page, pageIndex) => (
        <section class="page" data-page-index={pageIndex}>
          <BentoGrid services={page} />
        </section>
      ))
    }
  </main>

  <AddServiceModal />
</Layout>

<style>
  /* Botón oculto/discreto en la esquina superior izquierda */
  .secret-reset-btn {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 999;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.15); /* Muy tenue, casi invisible */
    padding: 6px;
    border-radius: 50%;
    cursor: pointer;
    transition: color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .secret-reset-btn:hover {
    color: #ef4444; /* Rojo tenue al pasar el mouse */
    background-color: rgba(239, 68, 68, 0.12);
    transform: scale(1.1);
  }

  /* Contenedor raíz */
  .slider {
    display: flex;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    box-sizing: border-box;
  }

  .slider::-webkit-scrollbar {
    display: none;
  }

  .page {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    scroll-snap-align: start;
    padding: clamp(0.75rem, 2.5vw, 2rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  .empty-state {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--text-muted);
  }
</style>

<script>
  import type { PingResponse } from "../types/hub";

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Lógica del botón secreto de eliminación de cookies
    const clearBtn = document.getElementById("clear-cookies-btn");
    
    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        // Elimina todas las cookies expirándolas inmediatamente
        document.cookie.split(";").forEach((cookie) => {
          const eqPos = cookie.indexOf("=");
          const name = eqPos > -1 ? cookie.substring(0, eqPos) : cookie;
          document.cookie = `${name.trim()}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
        });

        // Recarga la página para refrescar el layout desde el servidor
        window.location.reload();
      });
    }

    // 2. Ping de estado de servicios
    const blocks = document.querySelectorAll<HTMLElement>(".bento-block");

    blocks.forEach(async (block) => {
      const url = block.getAttribute("data-url");
      const dot = block.querySelector<HTMLElement>(".status-dot");
      if (!url || !dot) return;

      try {
        const res = await fetch("/api/ping", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url })
        });
        const data: PingResponse = await res.json();
        dot.classList.add(data.active ? "active" : "inactive");
        if (data.error) {
          console.error(`Error ping a ${url}: ${data.error}`);
        }
      } catch (e) {
        dot.classList.add("inactive");
      }
    });
  });
</script>