---
import fs from "fs/promises";
import path from "path";
import Layout from "../layouts/Layout.astro";
import BentoCard from "../components/BentoCard.astro";
import AddServiceModal from "../components/AddServiceModal.astro";
import type { Config, Service } from "../types/hub";

// Carga de configuración JSON
const configPath = path.join(process.cwd(), "data/config.json");
let config: Config = { maxPerPage: 10, services: [] };

try {
  const content = await fs.readFile(configPath, "utf-8");
  config = JSON.parse(content);
} catch (e) {
  console.log("Configuración inicial no encontrada. Usando estado por defecto.");
}

// Función tipada para paginado
const chunkArray = <T,>(arr: T[], size: number): T[][] =>
  Array.from({ length: Math.ceil(arr.length / size) }, (_, i) =>
    arr.slice(i * size, i * size + size)
  );

const pages: Service[][] = chunkArray(config.services, config.maxPerPage);
---

<Layout title="Local Hub - Bento Dashboard">
  <main class="slider">
    {
      pages.length === 0 ? (
        <div class="empty-state">
          <h2>No tienes servicios agregados</h2>
          <p>Haz clic en el botón '+' para agregar el primero.</p>
        </div>
      ) : null
    }

    {
      pages.map((page, pageIndex) => (
        <section class="page" data-page-index={pageIndex}>
          {page.map((service) => (
            <BentoCard service={service} />
          ))}
        </section>
      ))
    }
  </main>

  <AddServiceModal />
</Layout>

<style>
  /* Contenedor principal con Swipe / Scroll Snap horizontal */
  .slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    height: 100vh;
    width: 100vw;
    scrollbar-width: none;
  }

  .slider::-webkit-scrollbar {
    display: none;
  }

  /* Vista paginada */
  .page {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100vh;
    scroll-snap-align: start;
    padding: 2rem;
    box-sizing: border-box;
    display: grid;
    /* Responsive Grid: adapta columnas según pantalla */
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    grid-auto-rows: 180px;
    gap: 1.25rem;
    align-content: center;
  }

  .empty-state {
    width: 100vw;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--text-muted);
  }

  /* Ajustes Responsive para Móviles */
  @media (max-width: 640px) {
    .page {
      padding: 1rem;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      grid-auto-rows: 140px;
      gap: 0.75rem;
    }
  }
</style>

<script>
  import type { BentoLayoutItem, PingResponse } from "../types/hub";

  document.addEventListener("DOMContentLoaded", () => {
    const blocks = document.querySelectorAll<HTMLElement>(".bento-block");
    if (blocks.length === 0) return;

    // 1. RANDOMIZACIÓN Y PERSISTENCIA DE TAMAÑOS BENTO
    const isMobile = window.innerWidth < 640;
    let layout: BentoLayoutItem[] | null = null;

    try {
      const stored = sessionStorage.getItem("bentoLayout");
      if (stored) layout = JSON.parse(stored);
    } catch (e) {
      console.error("Error leyendo sessionStorage:", e);
    }

    if (!layout || layout.length !== blocks.length) {
      layout = Array.from(blocks).map(() => ({
        // En móviles limitamos la expansión a máximo 2 columnas
        colSpan: Math.random() > 0.75 ? 2 : 1,
        rowSpan: !isMobile && Math.random() > 0.8 ? 2 : 1
      }));
      sessionStorage.setItem("bentoLayout", JSON.stringify(layout));
    }

    blocks.forEach((block, index) => {
      if (layout && layout[index]) {
        block.style.gridColumn = `span ${layout[index].colSpan}`;
        block.style.gridRow = `span ${layout[index].rowSpan}`;
      }
    });

    // 2. PING EN TIEMPO REAL A CADA SERVICIO
    blocks.forEach(async (block) => {
      const url = block.getAttribute("data-url");
      const dot = block.querySelector<HTMLElement>(".status-dot");
      if (!url || !dot) return;

      try {
        const res = await fetch("/api/ping", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url })
        });
        const data: PingResponse = await res.json();
        dot.classList.add(data.active ? "active" : "inactive");
      } catch (e) {
        dot.classList.add("inactive");
      }
    });
  });
</script>